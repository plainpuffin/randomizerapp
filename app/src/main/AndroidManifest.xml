<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".RandomizerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_light"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_light_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Randomizer">
        <activity
            android:name=".NumberActivity"
            android:exported="false" />
        <activity
            android:name=".TeamResultActivity"
            android:exported="false" />
        <activity
            android:name=".TeamSetupActivity"
            android:exported="false" />
        <activity
            android:name=".CategoriesSetupActivity"
            android:exported="false" />
        <activity
            android:name=".CategoriesActivity"
            android:exported="false" />
        <activity
            android:name=".CoinActivity"
            android:exported="false" />
        <activity
            android:name=".DiceActivity"
            android:exported="false" />
        <activity
            android:name=".YatzyActivity"
            android:exported="false" />
        <activity
            android:name=".DiceDynamicActivity"
            android:exported="false" />
        <activity
            android:name=".StartMenu"
            android:exported="true" />

        <activity-alias
            android:name=".StartMenuLight"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:label="@string/app_name"
            android:targetActivity=".StartMenu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".StartMenuDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:label="@string/app_name"
            android:targetActivity=".StartMenu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
